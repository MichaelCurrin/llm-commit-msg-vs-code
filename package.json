{
  "name": "llm-commit-msg",
  "displayName": "llm-commit-msg",
  "description": "Generate commit message using a local LLM",
  "version": "0.3.0",
  "publisher": "michaelcurrin",
  "engines": {
    "vscode": "^1.104.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelCurrin/llm-commit-msg-vs-code"
  },
  "homepage": "https://michaelcurrin.github.io/llm-commit-msg-vs-code/",
  "bugs": {
    "url": "https://github.com/MichaelCurrin/llm-commit-msg-vs-code/issues"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llm-commit-msg.generateCommitMessage",
        "title": "Generate Commit Msg",
        "icon": "$(git-commit)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "llm-commit-msg.generateCommitMessage",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "LLM Commit Message",
      "properties": {
        "llmCommitMsg.endpoint": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Base URL of the OpenAI-compatible API (Ollama)."
        },
        "llmCommitMsg.model": {
          "type": "string",
          "default": "gemma3",
          "description": "Model name to use when generating messages."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "fmt": "prettier --write *.js",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "build": "vsce package --out build/llm-commit-msg.vsix",
    "ext": "npm run build && code --install-extension build/llm-commit-msg.vsix --force"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2"
  }
}
